Subject: [PATCH] drm/panel: l2s: bounded file-scoped fingerprint illumination

--- a/drivers/gpu/drm/panel/panel-xiaomi-l2s-380c0a.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-l2s-380c0a.c
@@ -5,6 +5,11 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/miscdevice.h>
+#include <linux/compat.h>
+#include <linux/kref.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
 #include <linux/debugfs.h>
 #include <linux/seq_file.h>
 #include <linux/delay.h>
@@ -28,6 +33,9 @@
 #include <drm/drm_probe_helper.h>
 
 #include "panel-xiaomi-l2s-runtime.h"
+#include "panel-xiaomi-l2s-fod-tables.h"
+
+struct l2s_fod;
 
