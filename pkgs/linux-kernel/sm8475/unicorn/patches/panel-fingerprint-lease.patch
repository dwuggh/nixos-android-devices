  * Select it again on every full modeset/wake, before touching panel power.
  */
+static int l2s_fod_end_locked(struct l2s_panel *ctx);
+
 static int l2s_panel_get_current_mode(struct l2s_panel *ctx)
 {
 	struct drm_connector *connector = ctx->connector;
@@ -221,6 +233,8 @@
 	int ret;
 
 	mutex_lock(&ctx->lock);
+	if (ctx->fod_active)
+		l2s_fod_end_locked(ctx);
 	if (!ctx->prepared || !ctx->enabled || ctx->idle_active ||
 	    ctx->runtime_failed || ctx->refresh != drm_mode_vrefresh(old)) {
 		ret = -EBUSY;
@@ -261,6 +275,7 @@
 {
 	struct l2s_panel *ctx = to_l2s_panel(panel);
 	return idle_hz && state->enable && !state->vrr_enabled &&
+	       !READ_ONCE(ctx->fod_active) && !READ_ONCE(ctx->fod_acquiring) &&
