diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-fingerprint.dtsi b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-fingerprint.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn-fingerprint.dtsi
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/* OEM reset GPIO41, IRQ GPIO40 and L11C 3.008 V. No SPI ownership change. */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	fingerprint {
+		compatible = "xiaomi,unicorn-fingerprint";
+		vdd-supply = <&pm8350c_l11>;
+		reset-gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <40 IRQ_TYPE_EDGE_RISING>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&unicorn_fp_reset &unicorn_fp_irq>;
+		wakeup-source;
+	};
+};
+
+&tlmm {
+	unicorn_fp_reset: fingerprint-reset-state {
+		pins = "gpio41";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	unicorn_fp_irq: fingerprint-irq-state {
+		pins = "gpio40";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		input-enable;
+	};
+};
diff --git a/Documentation/devicetree/bindings/misc/xiaomi,unicorn-fingerprint.yaml b/Documentation/devicetree/bindings/misc/xiaomi,unicorn-fingerprint.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/misc/xiaomi,unicorn-fingerprint.yaml
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/xiaomi,unicorn-fingerprint.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi 12S Pro secure fingerprint hardware control
+
+maintainers:
+  - Linux input maintainers <linux-input@vger.kernel.org>
+
+description: |
+  Board control interface for a secure-world-owned Goodix optical fingerprint
+  device. The fitted sensor model is determined by the trusted application.
+  Only supply, reset and interrupt resources belong to the normal world.
+
+properties:
+  compatible:
+    const: xiaomi,unicorn-fingerprint
+  vdd-supply: true
+  reset-gpios:
+    maxItems: 1
+  interrupts:
+    maxItems: 1
+  wakeup-source: true
+
+required:
+  - compatible
+  - vdd-supply
+  - reset-gpios
+  - interrupts
+
+additionalProperties: false
diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-unicorn.dts
@@ -13,6 +13,7 @@
 #include "pmk8350.dtsi"
 #include "pmr735a.dtsi"
 #include "sm8475-xiaomi-unicorn-wireless.dtsi"
+#include "sm8475-xiaomi-unicorn-fingerprint.dtsi"
 
 /* These SM8450 reference reservations differ on unicorn. */
 /delete-node/ &adsp_mem;
