-	    arg->num_params > 2 + 2 * QSEECOM_TEE_MAX_PATCH)
+	if (arg->func == QSEECOM_ALLOC_PRIVATE ? arg->num_params != 0 :
+	    (arg->num_params < 2 || (arg->num_params & 1) ||
+	     arg->num_params > 2 + 2 * QSEECOM_TEE_MAX_PATCH))
 		return -EINVAL;
 
 	mutex_lock(&ctxdata->mutex);
@@ -824,6 +967,7 @@
 	app_id = sess ? sess->app_id : 0;
 	app_gen = sess ? sess->app_gen : 0;
 	found = sess;
+	private_dma = ctxdata->private_dma;
 	mutex_unlock(&ctxdata->mutex);
 
 	if (!found)
@@ -838,6 +982,9 @@
 	if (!qseecom_tee_app_current(ctxdata->qtee, app_id, app_gen))
 		return -ENOENT;
 
+	if (arg->func == QSEECOM_ALLOC_PRIVATE)
+		return qseecom_private_alloc(ctxdata);
+
 	ret = qseecom_tee_memref(&param[0], TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT,
 				 &req, &req_size);
 	if (ret)
@@ -849,8 +996,22 @@
 		return ret;
 
 	for (i = 2; i < arg->num_params; i += 2) {
-		ret = qseecom_tee_check_patch(&param[i], &param[i + 1],
-					      req_size);
+		for (j = 2; j < i; j += 2)
+			if (param[i].u.value.a < param[j].u.value.a + param[j].u.value.b &&
