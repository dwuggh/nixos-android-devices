Subject: [PATCH] tee: qseecom: export bounded private TA/CDSP memory

--- a/drivers/tee/qseecom/core.c
+++ b/drivers/tee/qseecom/core.c
@@ -47,6 +47,10 @@
 
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/firmware/qcom/qcom_tzmem.h>
