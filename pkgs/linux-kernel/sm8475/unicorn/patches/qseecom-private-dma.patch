  */
 struct qseecom_tee_context {
+	struct dma_buf *private_dma;
 	struct qseecom_tee *qtee;
 	struct mutex mutex;
 	struct list_head sessions;
@@ -431,6 +436,8 @@
 		kfree(sess);
 	}
 
+	if (ctxdata->private_dma)
+		dma_buf_put(ctxdata->private_dma);
 	mutex_destroy(&ctxdata->mutex);
 	kfree(ctxdata);
 	ctx->data = NULL;
@@ -771,7 +778,7 @@
 	off = voff->u.value.a;
 	width = voff->u.value.b;
 
-	if (width != 4 && width != 8)
