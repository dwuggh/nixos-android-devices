 }
 
+
+/* Local client ABI, deliberately outside the TA command namespace. Allocation
+ * returns fd + 1 as the ioctl return value (including when fd is zero); it has
+ * no output parameters that could fault after the fd has been installed.
+ * These buffers have no mmap/vmap operation. Only the owning TEE context can
+ * patch their physical address into its commands. A context owns at most one
+ * 4 MiB buffer, retained until its TA sessions have been released. */
+#define QSEECOM_ALLOC_PRIVATE 0x55460001
+#define QSEECOM_PRIVATE_SIZE SZ_4M
+#define QSEECOM_PATCH_PRIVATE 1
+struct qseecom_private_dma {
+	struct qcom_tzmem_pool *pool;
+	void *memory;
+	phys_addr_t phys;
+};
+
+static struct sg_table *qseecom_private_map(struct dma_buf_attachment *attach,
+					   enum dma_data_direction direction)
+{
+	struct qseecom_private_dma *p = attach->dmabuf->priv;
+	struct sg_table *sgt;
+	int ret;
+
+	sgt = kzalloc_obj(*sgt);
+	if (!sgt)
+		return ERR_PTR(-ENOMEM);
+	ret = sg_alloc_table(sgt, 1, GFP_KERNEL);
+	if (ret)
+		goto free;
+	sg_set_page(sgt->sgl, pfn_to_page(PHYS_PFN(p->phys)),
+		    QSEECOM_PRIVATE_SIZE, 0);
+	ret = dma_map_sgtable(attach->dev, sgt, direction, DMA_ATTR_SKIP_CPU_SYNC);
+	if (ret) {
+		sg_free_table(sgt);
+		goto free;
+	}
+	return sgt;
+free:
+	kfree(sgt);
+	return ERR_PTR(ret);
+}
+
+static void qseecom_private_unmap(struct dma_buf_attachment *attach,
+		struct sg_table *sgt, enum dma_data_direction direction)
+{
+	dma_unmap_sgtable(attach->dev, sgt, direction, DMA_ATTR_SKIP_CPU_SYNC);
+	sg_free_table(sgt);
+	kfree(sgt);
+}
+
+static void qseecom_private_release(struct dma_buf *buf)
+{
+	struct qseecom_private_dma *p = buf->priv;
+
+	memzero_explicit(p->memory, QSEECOM_PRIVATE_SIZE);
+	qcom_tzmem_free(p->memory);
+	qcom_tzmem_pool_free(p->pool);
+	kfree(p);
+}
+
+static const struct dma_buf_ops qseecom_private_ops = {
+	.map_dma_buf = qseecom_private_map,
+	.unmap_dma_buf = qseecom_private_unmap,
+	.release = qseecom_private_release,
+};
+
+static int qseecom_private_alloc(struct qseecom_tee_context *ctxdata)
+{
+	struct qcom_tzmem_pool_config config = {
+		.initial_size = QSEECOM_PRIVATE_SIZE,
+		.max_size = QSEECOM_PRIVATE_SIZE,
+		.policy = QCOM_TZMEM_POLICY_STATIC,
+	};
+	DEFINE_DMA_BUF_EXPORT_INFO(info);
+	struct qseecom_private_dma *p;
+	struct dma_buf *buf;
+	int ret;
+
+	mutex_lock(&ctxdata->mutex);
+	if (ctxdata->private_dma) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	p = kzalloc_obj(*p);
+	if (!p) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+	p->pool = qcom_tzmem_pool_new(&config);
+	if (IS_ERR(p->pool)) {
+		ret = PTR_ERR(p->pool);
+		goto free;
+	}
+	p->memory = qcom_tzmem_alloc(p->pool, QSEECOM_PRIVATE_SIZE, GFP_KERNEL);
+	if (!p->memory) {
+		ret = -ENOMEM;
+		goto pool;
+	}
+	p->phys = qcom_tzmem_to_phys(p->memory);
+	if (!p->phys || upper_32_bits(p->phys + QSEECOM_PRIVATE_SIZE - 1)) {
+		ret = -EOVERFLOW;
+		goto memory;
+	}
+	memset(p->memory, 0, QSEECOM_PRIVATE_SIZE);
+	info.ops = &qseecom_private_ops;
+	info.size = QSEECOM_PRIVATE_SIZE;
+	info.flags = O_RDWR;
+	info.priv = p;
+	buf = dma_buf_export(&info);
+	if (IS_ERR(buf)) {
+		ret = PTR_ERR(buf);
+		goto memory;
+	}
+	get_dma_buf(buf); /* Context reference, independent of installed fd. */
+	ret = dma_buf_fd(buf, O_CLOEXEC);
+	if (ret < 0) {
+		dma_buf_put(buf);
+		dma_buf_put(buf);
+		goto unlock;
+	}
+	ctxdata->private_dma = buf;
+	ret++;
+	goto unlock;
+memory:
+	qcom_tzmem_free(p->memory);
+pool:
+	qcom_tzmem_pool_free(p->pool);
+free:
+	kfree(p);
+unlock:
+	mutex_unlock(&ctxdata->mutex);
+	return ret;
+}
+
