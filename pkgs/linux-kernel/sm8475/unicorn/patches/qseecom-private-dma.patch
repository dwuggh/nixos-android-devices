 						    param[k + 1].u.memref.shm_offs);
 				if (!IS_ERR(pv))
@@ -1948,3 +2121,5 @@
 MODULE_AUTHOR("Dawid Wróbel <me@dawidwrobel.com>");
 MODULE_DESCRIPTION("Qualcomm QSEECOM TEE driver");
 MODULE_LICENSE("GPL");
