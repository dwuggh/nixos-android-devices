+			if (param[i + 1].attr != TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT ||
+			    param[i + 1].u.value.a || param[i + 1].u.value.b ||
+			    param[i + 1].u.value.c || !private_dma ||
+			    (param[i].u.value.b != 4 && param[i].u.value.b != 8) ||
+			    param[i].u.value.b > req_size ||
+			    param[i].u.value.a > req_size - param[i].u.value.b)
+				return -EINVAL;
+			continue;
+		}
+		ret = qseecom_tee_check_patch(&param[i], &param[i + 1], req_size);
 		if (ret)
 			return ret;
 	}
@@ -874,7 +1035,8 @@
 		 */
 		need = req_size + rsp_size;
 		for (k = 2; k < arg->num_params; k += 2)
-			need += param[k + 1].u.memref.size;
+			if (!param[k].u.value.c)
